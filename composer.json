{
    "name": "request-interop/interface",
    "description": "Interoperable server request interfaces for PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Paul M. Jones",
            "email": "pmjones@pmjones.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "RequestInterop\\Interface\\": "./src"
        }
    },
    "require": {
        "php": ">=8.4",
        "stream-interop/interface": "1.x@dev",
        "upload-interop/interface": "1.x@dev",
        "uri-interop/interface": "1.x@dev"
    },
    "require-dev": {
        "pds/skeleton": "^1.0",
        "phpstan/phpstan": "^2.0",
        "star-interop/stardoc": "1.x-dev"
    },
    "scripts": {
        "analyze": "./vendor/bin/phpstan analyze -c phpstan.neon",
        "check": "composer analyze"
    }
}
